# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Next.js app (mirrors the values above)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only Supabase key for Atlas repository import/promotion API routes.
# Never expose this as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Development
VITE_APP_ENV=development
VITE_APP_NAME=Neptino Educational Platform
NODE_ENV=development

# Hugging Face Inference
HF_TOKEN=your_hugging_face_token
HF_AUDIO_TRANSCRIBE_MODEL=openai/whisper-large-v3-turbo
